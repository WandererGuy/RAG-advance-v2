# secrets — catch .env at root, backend/, frontend/, everywhere
.env
.env.*
!.env.example
!.env.*.example

# corpus — data/raw/ is ignored by default, so a real document dropped in never
# lands in a commit by accident. data/raw/HR_pdfs/ is the deliberate exception:
# it is the synthetic v1 demo corpus and is committed and safe to show (ADR-0001).
data/raw/*
!data/raw/.gitkeep
!data/raw/HR_pdfs/
!data/samples/

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# local db files
*.db
*.sqlite3

# scratch
.DS_Store
