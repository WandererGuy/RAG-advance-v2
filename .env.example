# Copy to .env and fill in the two API keys. .env is gitignored; this file is committed
# with secrets left empty. Single source of truth: docker compose and the backend both read it.

# --- Postgres (consumed by docker-compose.yml) ---
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
POSTGRES_PORT=5432

# --- Backend ---
# Must use the postgresql+asyncpg:// scheme — see ADR-0002. Host is localhost because the
# API and the CLI scripts run on the host, not inside a container.
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag
LOG_LEVEL=INFO

# --- LLM (via LiteLLM) ---
DEFAULT_LLM_NAME=RAG_DEMO_KEY
DEFAULT_LLM_PROVIDER=GEMINI
DEFAULT_LLM_MODEL_NAME=gemini-3.6-flash
DEFAULT_LLM_API_KEY=
# OPTIONAL: custom API base URL (leave blank for provider default)
DEFAULT_LLM_API_BASE=
# OPTIONAL: only needed when DEFAULT_LLM_PROVIDER=CUSTOM
DEFAULT_LLM_CUSTOM_PROVIDER=

# --- Embedding ---
# Changing EMBEDDING_DIMENSIONS is a schema migration plus a full re-ingest plus a re-run of
# every pipeline — the vector column dimension must be changed to match. See ADR-0002.
EMBEDDING_PROVIDER=GEMINI
EMBEDDING_MODEL_NAME=gemini-embedding-001
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=768

# --- Pipeline defaults (Phase 4+) ---
# Frozen at these values until Phase 6 per CLAUDE.md section 5.3.
PIPELINE_NAME=naive-v1
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=5
PROMPT_VERSION=v1
